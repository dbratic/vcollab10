@{
    ViewData["Title"] = "SD Plus Report";
    var users = ViewBag.UserList;
    var clients = ViewBag.ClientList;
    var accounts = ViewBag.AccountList;
    var filters = ViewBag.FilterList;
    var filtersPublic = ViewBag.FilterPublicList;
    var departments = ViewBag.DepartmentList;
    var statusList = ViewBag.StatusList;
    var isAppManagerRole = ViewBag.IsAppManager?.ToString().ToLower();
    var tabDisabled = ViewBag.TabDisabled?.ToString().ToLower();
    var timesheetStatusList = ViewBag.TimesheetStatusList;
    var approvers = ViewBag.TimesheetApproverList;
}

<input type="hidden" id="hdnAppManager" value="@isAppManagerRole" />
<div class="bg-light p-3 rounded-3 border border-info">
    <ul class="nav nav-pills mb-3" id="pills-tab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="pills-home-tab" data-bs-toggle="pill" data-bs-target="#pills-home" type="button" role="tab" aria-controls="pills-home" aria-selected="true">Time Reporting</button>
        </li>
        <li class="nav-item @tabDisabled" role="presentation">
            <button class="nav-link" id="pills-profile-tab" data-bs-toggle="pill" data-bs-target="#pills-profile" type="button" role="tab" aria-controls="pills-profile" aria-selected="false" @tabDisabled>Ticketing</button>
        </li>
        <li class="nav-item @tabDisabled" role="presentation">
            <button class="nav-link" id="pills-timesheet-tab" data-bs-toggle="pill" data-bs-target="#pills-timesheet" type="button" role="tab" aria-controls="pills-timesheet" aria-selected="false" @tabDisabled>Timesheet</button>
        </li>
        @* <li class="nav-item @tabDisabled" role="presentation">
            <button class="nav-link" id="pills-department-tab" data-bs-toggle="pill" data-bs-target="#pills-department" type="button" role="tab" aria-controls="pills-department" aria-selected="false" @tabDisabled>Name and Department</button>
        </li> *@
    </ul>
    <div class="tab-content" id="pills-tabContent">
        <div class="tab-pane fade show active" id="pills-home" role="tabpanel" aria-labelledby="pills-home-tab" tabindex="0">
            <div class="col-12">
                <div class="row">
                    <div class="col-6" style="padding-bottom:7px">
                        <span style="font-weight:bold; font-size:larger">Report</span> -
                        <select id="lstReportType">
                            @* <option value="Detailed">Detailed Report</option> *@
                            <option value="DetailedM">Detailed Report</option>
                            <option value="Summary">Summary Report</option>
                            <option value="HoursByDay">Hours By Day</option>
                            <option value="HoursByPerson">Hours By Person</option>

                            @if (ViewBag.IsAdmin)
                            {
                                <option value="HoursByAccount">Hours By Account</option>
                                <option value="HoursByAccountDetails">Hours By Account Details</option>
                                <option value="Compliance">Time Logging Compliance</option>
                                <option value="UtilizationByPerson">Utilization By Person</option>
                                <option value="UtilizationByDepartment">Utilization By Department</option>
                                <option value="Inventory">Client, Account, Project Inventory</option>
                            }
                        </select>
                    </div>
                    <div class="col-6" style="text-align:right">
                        <select id="lstSavedReports" @(filters == null && filtersPublic == null ? " class=d-none" : "")>
                            <option value="">--- My saved filters ---</option>
                            @if (filters != null)
                            {
                                foreach (var filter in filters)
                                {
                                    <option value="@filter.ReportName">@filter.ReportName</option>
                                }
                            }
                            @if (ViewBag.IsAdmin)
                            {
                                <option value="">--- Public filters ---</option>
                                if (filtersPublic != null)
                                {
                                    foreach (var filterPublic in filtersPublic)
                                    {
                                        <option value="@filterPublic.ReportName">@filterPublic.ReportName</option>
                                    }
                                }
                            }
                        </select>
                        <span id="spnPlaceholder" style="padding-left:47px">&nbsp;</span><span id="spnDelete" class="d-none"><button id="btnDeleteReport" class="btn btn-primary btn-xs">Delete</button></span> <span id="spnDeleteSpinner" class="d-none"><img src="~/spinner.gif" width="30" height="30" alt="" /></span>
                    </div>
                </div>
            </div>
            <div class="col-12">
                <div class="row filterArea">
                    <div class="col-4 p-2">
                        <label for="lstUser" class="form-label"><b>User Name</b></label><br />
                        <select id="lstUser" multiple="multiple" class="form-select bg-light">
                            @foreach (var user in users)
                            {
                                string strUser = user.Id + "-" + user.UserName;
                                <option value="@user.Id">@strUser</option>
                            }
                        </select>
                    </div>
                    <div class="col-4 p-2">
                        <label for="lstClient" class="form-label"><b>Client Name</b></label><br />
                        <select id="lstClient" multiple="multiple" class="form-select bg-light">
                            @foreach (var client in clients)
                            {
                                <option value="@client.ClientName">@client.ClientName</option>
                            }
                        </select>
                    </div>
                    <div class="col-4 p-2">
                        <label class="form-label"><b>Account Name</b></label><br />
                        <select id="lstClientAccount" multiple="multiple" class="form-select bg-light">
                            @foreach (var account in accounts)
                            {
                                <option value="@account.Id">@account.AccountName</option>
                            }
                        </select>
                    </div>
                    <div class="col-4 p-2">
                        <label class="form-label"><b>Module</b></label>
                        <select id="lstModule" multiple="multiple" class="form-select">
                            <option value="Change">Change</option>
                            <option value="Problem">Problem</option>
                            <option value="Project">Project</option>
                            <option value="Request">Request</option>
                        </select>
                    </div>
                    <div class="col-4 p-2">
                        <label class="form-label"><b>Request Type</b></label>
                        <select id="lstRequestType" class="form-select">
                            <option value="">All Request Types</option>
                            <option value="Service Request">Service Request</option>
                            <option value="Incident">Incident</option>
                        </select>
                    </div>
                    <div class="col-4 p-2">
                        <label class="form-label"><b>Is Billable</b></label>
                        <select id="lstBillable" class="form-select">
                            <option value="">All</option>
                            <option value="true">Billable</option>
                            <option value="false">Not Billable</option>
                        </select>
                    </div>
                    <div class="col-4 p-2">
                        <label class="form-label"><b>Department</b></label>
                        <select id="lstDepartment" multiple="multiple" class="form-select bg-light">
                            @foreach (var dept in departments)
                            {
                                <option value="@dept.DepartmentName">@dept.DepartmentName</option>
                            }
                        </select>
                    </div>
                    <div class="col-4 p-2">
                        <label class="form-label"><b>Employment Type</b></label>
                        <select id="lstEmploymentType" multiple="multiple" class="form-select bg-light">
                            <option value="Emp">Emp</option>
                            <option value="Con">Con</option>
                        </select>
                    </div>
                    <div class="col-4 p-2">
                        <label class="form-label"><b>Location</b></label>
                        <select id="lstLocation" multiple="multiple" class="form-select bg-light">
                            <option value="North America">North America</option>
                            <option value="India">India</option>
                        </select>
                    </div>
                    <div class="col-4 p-2">
                        <label class="form-label"><b>Record Date</b></label>
                        <select id="lstRecordDate" class="form-select">
                            <option value="Today">Today</option>
                            <option value="Yesterday">Yesterday</option>
                            <option value="Current Week">Current Week</option>
                            <option value="Last Week">Last Week</option>
                            <option value="Current Month">Current Month</option>
                            <option value="Last Month">Last Month</option>
                            <option value="Custom Date">Date Range</option>
                            <option value="Since Inception">Since Inception</option>
                        </select>
                    </div>
                    <div class="col-4 p-2">
                        <div id="divDateStart">
                            <label class="form-label"><b>Start Date</b></label>
                            <input type="text" data-format="MM/dd/yyyy" class="form-control" id="txtStartDate">
                        </div>
                    </div>
                    <div class="col-4 p-2">
                        <div id="divDateEnd">
                            <label class="form-label"><b>End Date</b></label>
                            <input type="text" data-format="MM/dd/yyyy" class="form-control" id="txtEndDate">
                        </div>
                    </div>
                    <div class="col-4 p-2">
                        <button id="btnGenerateReport" class="btn btn-primary">Generate Report</button>
                    </div>
                    <div class="col-8 p-2" style="text-align:right">
                        Save filter as:
                        <select id="lstFilterType" @(ViewBag.IsAdmin ? "" : " class=d-none")>
                            <option value="Private">Private</option>
                            <option value="Public">Public</option>
                        </select>
                        <input type="text" id="txtReportName"> <span id="spnSave"><button id="btnSaveReport" class="btn btn-primary btn-sm">Save</button></span> <span id="spnSpinner" class="d-none"><img src="~/spinner.gif" width="30" height="30" alt="" /></span>
                    </div>
                    <div id="errReportName" class="col-12 p-2 d-none text-danger small" style="text-align:right; margin-top:-20px">
                        <span style="padding-right:90px">Please enter filter name</span>
                    </div>
                </div>
            </div>
            <div id="dvReport" class="d-none mt-5">
                <div class="row">
                    <div class="col-12"><h3>Report <span id="totalHrs"></span></h3></div>
                    <div class="clearfix"></div>
                </div>
                <div class="row">
                    <div id="dvFailed" class="col-12 alert alert-danger d-none"></div>
                </div>
                <div class="row">
                    <div style="overflow:auto;">
                        <table id="tblReport" class="table table-striped table-bordered table-responsive">
                            <thead>
                                <tr>
                                    <th class="dt_th">Client ID</th>
                                    <th class="dt_th">Client Name</th>
                                    <th class="dt_th">Account ID</th>
                                    <th class="dt_th">Account Name</th>
                                    <th class="dt_th">User ID</th>
                                    <th class="dt_th">User Name</th>
                                    <th class="dt_th">User Email</th>
                                    <th class="dt_th">Employment Type</th>
                                    <th class="dt_th">Department Name</th>
                                    <th class="dt_th">Location</th>
                                    <th class="dt_th">Work Log ID</th>
                                    <th class="dt_th">Module</th>
                                    <th class="dt_th">Module ID</th>
                                    <th class="dt_th">Module Title/Subject</th>
                                    <th class="dt_th">Request Type</th>
                                    <th class="dt_th">Task ID</th>
                                    <th class="dt_th">Task Title</th>
                                    <th class="dt_th">Work Log Description</th>
                                    <th class="dt_th">Is Billable</th>
                                    <th class="dt_th">Record Start Date</th>
                                    <th class="dt_th">Record End Date</th>
                                    <th class="dt_th">Work log Created Date</th>
                                    <th class="dt_th">Work log Created Time</th>
                                    <th class="dt_th">Time Spent (Hrs)</th>
                                    <th class="dt_th">Billing Status</th>
                                    <th class="dt_th">Created By</th>
                                    <th class="dt_th">VC Old Project ID</th>
                                </tr>
                            </thead>
                        </table>
                        <table id="tblReportSummary" class="table table-striped table-bordered table-responsive">
                            <thead>
                                <tr>
                                    <th class="dt_th">Client Name</th>
                                    <th class="dt_th">Account Name</th>
                                    <th class="dt_th">User Name</th>
                                    <th class="dt_th">Department Name</th>
                                    <th class="dt_th">Location</th>
                                    <th class="dt_th">Work Log ID</th>
                                    <th class="dt_th">Task ID</th>
                                    <th class="dt_th">Task Title</th>
                                    <th class="dt_th">Work Log Description</th>
                                    <th class="dt_th">Is Billable</th>
                                    <th class="dt_th">Record End Date</th>
                                    <th class="dt_th">Time Spent (Hrs)</th>
                                </tr>
                            </thead>
                        </table>
                        <table id="tblReportHoursByDay" class="table table-striped table-bordered table-responsive" style="width:150px">
                            <thead>
                                <tr>
                                    <th class="dt_th">Date</th>
                                    <th class="dt_th">Hours</th>
                                </tr>
                            </thead>
                        </table>
                        <table id="tblReportHoursByPerson" class="table table-striped table-bordered table-responsive" style="width:250px">
                            <thead>
                                <tr>
                                    <th class="dt_th">User Name</th>
                                    <th class="dt_th">Hours</th>
                                </tr>
                            </thead>
                        </table>
                        <table id="tblHoursByAccount" class="display table table-striped table-responsive table-bordered border-info">
                            <thead></thead>
                            <tbody></tbody>
                        </table>
                        <table id="tblHoursByAccountDetails" class="display table table-striped table-responsive table-bordered border-info">
                            <thead></thead>
                            <tbody></tbody>
                        </table>
                        <table id="tblReportCompliance" class="table table-striped table-bordered table-responsive" style="width:250px">
                            <thead>
                                <tr>
                                    <th class="dt_th">User ID</th>
                                    <th class="dt_th">User Name</th>
                                    <th class="dt_th">Employment Type</th>
                                    <th class="dt_th">Department Name</th>
                                    <th class="dt_th">Location</th>
                                    <th class="dt_th">Hours</th>
                                </tr>
                            </thead>
                        </table>
                        <table id="tblReportUtilizationByPerson" class="table table-striped table-bordered table-responsive" style="width:250px">
                            <thead>
                                <tr>
                                    <th class="dt_th">User ID</th>
                                    <th class="dt_th">User Name</th>
                                    <th class="dt_th">User Email</th>
                                    <th class="dt_th">Department Name</th>
                                    <th class="dt_th">Location</th>
                                    <th class="dt_th">Utilization Start Date</th>
                                    <th class="dt_th">Utilization End Date</th>
                                    <th class="dt_th">Number of Business Days</th>
                                    <th class="dt_th">Total Billable Client Hours</th>
                                    <th class="dt_th">Total Non Billable Hours</th>
                                    <th class="dt_th">Utilization</th>
                                </tr>
                            </thead>
                        </table>
                        <table id="tblReportUtilizationByDepartment" class="table table-striped table-bordered table-responsive" style="width:250px">
                            <thead>
                                <tr>
                                    <th class="dt_th">Department Name</th>
                                    <th class="dt_th">Utilization Start Date</th>
                                    <th class="dt_th">Utilization End Date</th>
                                    <th class="dt_th">Number of Business Days</th>
                                    <th class="dt_th">Total Billable Client Hours</th>
                                    <th class="dt_th">Total Non Billable Hours</th>
                                    <th class="dt_th">Utilization</th>
                                </tr>
                            </thead>
                        </table>
                        <table id="tblReportInventory" class="table table-striped table-bordered table-responsive" style="width:250px">
                            <thead>
                                <tr>
                                    <th class="dt_th">Client ID</th>
                                    <th class="dt_th">Client Name</th>
                                    <th class="dt_th">Old Vcollab ID</th>
                                    <th class="dt_th">Account ID</th>
                                    <th class="dt_th">Account Name</th>
                                    <th class="dt_th">Created Date</th>
                                    <th class="dt_th">Account Activity</th>
                                    <th class="dt_th">Last Work Log </th>
                                    <th class="dt_th">Project ID</th>
                                    <th class="dt_th">Project Name</th>
                                </tr>
                            </thead>
                        </table>

                    </div>
                </div>
            </div>
            <div>
                <div class="clearfix">&nbsp;</div>
            </div>
        </div>
        <div class="tab-pane fade" id="pills-profile" role="tabpanel" aria-labelledby="pills-profile-tab" tabindex="0">
            <div class="col-12">
                <span style="font-weight:bold; font-size:larger">Report</span> -
                <select id="lstTicketingReportType">
                    <option value="Budget">Budget vs Actual</option>
                    <option value="SLA1">SLA Report</option>
                   @*  <option value="HoursByDay">Hours By Day</option> *@
                </select>  <br />
                <div class="row filterArea">
                    <div class="col-4 p-2">
                        <label class="form-label"><b>Account Name</b></label><br />
                        <select id="lstClientAccount1" multiple="multiple" class="form-select bg-light">
                            @foreach (var account in accounts)
                            {
                                <option value="@account.Id">@account.AccountName</option>
                            }
                        </select>
                    </div>
                    <div class="col-4 p-2">
                        <label class="form-label"><b>Status</b></label><br />
                        <select id="lstAccountStatus" multiple="multiple" class="form-select bg-light">
                            @foreach (var status in statusList)
                            {
                                <option value="@status.Id">@status.StatusName</option>
                            }
                        </select>
                    </div>
                    <div class="col-4 p-2">
                        <label class="form-label">&nbsp;</label><br />
                        <button id="btnGenerateBudgetReport" class="btn btn-primary">Generate Report</button>
                    </div>
                </div>
            </div>
            <div id="dvBudgetReport" class="d-none mt-5">
                <div class="row">
                    <div class="col-12"><h3>Budget Estimated vs Actual</h3></div>
                    <div class="clearfix"></div>
                </div>
                <div class="row">
                    <div id="dvBudgetFailed" class="col-12 alert alert-danger d-none"></div>
                </div>
                <div class="row">
                    <div style="overflow:auto;">
                        <table id="tblBudgetReport" class="table table-striped table-bordered table-responsive">
                            <thead>
                                <tr>
                                    <th class="dt_th">Account ID</th>
                                    <th class="dt_th">Account Name</th>
                                    <th class="dt_th">Open Date</th>
                                    <!-- <th class="dt_th">Close Date</th> -->
                                    <th class="dt_th">Status</th>
                                    <th class="dt_th">Ticket Number</th>
                                    <th class="dt_th">Ticket Subject</th>
                                    <th class="dt_th">Task Number</th>
                                    <th class="dt_th">Task Name</th>
                                    <th class="dt_th">Estimated Hours</th>
                                    <th class="dt_th">Billable Total</th>
                                    <th class="dt_th">Non-Billable Total</th>
                                    <th class="dt_th">Actual Total Hours</th>
                                    <th class="dt_th">Hour Difference</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="pills-timesheet" role="tabpanel" aria-labelledby="pills-timesheet-tab" tabindex="0">
            <div class="col-12">
                <div class="pt-2 pb-2">
                    <span style="font-weight:bold; font-size:larger">Report</span> -
                    <select id="lstTimesheetType">
                        <option value="TAR">Timesheet Approval Report</option>
                        <option value="TCR">Timesheet Count Report</option>
                    </select>
                </div>
                <div class="row filterArea">
                    <div class="col-3 p-2">
                        <label class="form-label"><b>Department</b></label><br />
                        <select id="lstTimeDepartment" multiple="multiple" class="form-select bg-light">
                            @foreach (var department in departments)
                            {
                                <option value="@department.DepartmentName">@department.DepartmentName</option>
                            }
                        </select>
                    </div>
                    <div class="col-3 p-2">
                        <label class="form-label"><b>Employee Type</b></label><br />
                        <select id="lstTimeEmployeeType" multiple="multiple" class="form-select bg-light">
                            <option value="Emp">Emp</option>
                            <option value="Con">Con</option>
                        </select>
                    </div>
                    <div class="col-3 p-2">
                        <label class="form-label"><b>Location</b></label><br />
                        <select id="lstTimeLocation" multiple="multiple" class="form-select bg-light">
                            <option value="North America">North America</option>
                            <option value="India">India</option>
                        </select>
                    </div>
                    <div class="col-3 p-2">
                        <label class="form-label"><b>Approver</b></label>
                        <select id="lstTimeApprover" multiple="multiple" class="form-select bg-light">
                            @foreach (var approver in approvers)
                            {
                                <option value="@approver.Id">@approver.ApproverName</option>
                            }
                        </select>
                    </div>
                    <div class="col-3 p-2">
                        <label class="form-label"><b>Status</b></label><br />
                        <select id="lstTimeStatus" multiple="multiple" class="form-select bg-light">
                            @foreach (var status in timesheetStatusList)
                            {
                                <option value="@status.Id">@status.StatusName</option>
                            }
                            @* <option value="0">Not Created</option> *@
                        </select>
                    </div>
                    <div class="col-3 p-2">
                        <div id="divTimesheetDateStart">
                            <label class="form-label"><b>Timesheet Start Date</b></label>
                            <input type="text" data-format="MM/dd/yyyy" class="form-control" id="txtTimesheetStartDate">
                        </div>
                    </div>
                    <div class="col-3 p-2">
                        <div id="divTimesheetDateEnd">
                            <label class="form-label"><b>Timesheet End Date</b></label>
                            <input type="text" data-format="MM/dd/yyyy" class="form-control" id="txtTimesheetEndDate">
                        </div>
                    </div>

                    <div class="col-3 p-2">
                        <label class="form-label">&nbsp;</label><br />
                        <button id="btnGenerateTimesheetReport" class="btn btn-primary">Generate Report</button>
                    </div>
                </div>
                <div id="dvTimesheetReport" class="d-none mt-5">
                    <div class="row">
                        <div class="col-12">
                            <h3>Timesheet Approval Report</h3>
                        </div>
                        <div class="clearfix"></div>
                    </div>
                    <div class="row">
                        <div id="dvTimesheetFailed" class="col-12 alert alert-danger d-none"></div>
                    </div>
                    <div class="row">
                        <div style="overflow:auto;">
                            <table id="tblTimesheetReport" class="table table-striped table-bordered table-responsive">
                                <thead>
                                    <tr>
                                        <th class="dt_th">Timesheet Id</th>
                                        <th class="dt_th">Technician Id</th>
                                        <th class="dt_th">Technician Name</th>
                                        <th class="dt_th">Department</th>
                                        <th class="dt_th">Start Date</th>
                                        <th class="dt_th">End Date</th>
                                        <th class="dt_th">Total Time Spent</th>
                                        <th class="dt_th">Status</th>
                                        <th class="dt_th">Approver</th>
                                        <th class="dt_th">Approved Date</th>
                                        <th class="dt_th">Location</th>
                                        <th class="dt_th">Employee Type</th>
                                    </tr>
                                </thead>
                            </table>
                        </div>
                    </div>
                </div>
                <div id="dvTimesheetCountReport" class="d-none mt-5">
                    <div class="row">
                        <div class="col-12">
                            <h3>Timesheet Count Report</h3>
                        </div>
                        <div class="clearfix"></div>
                    </div>
                    <div class="row">
                        <div style="overflow:auto;">
                            <table id="tblTimesheetCountReport" class="table table-striped table-bordered table-responsive">
                                <thead>
                                    <tr>
                                        <th class="dt_th">Employee Name</th>
                                        <th class="dt_th">User Creation Date</th>
                                        <th class="dt_th">Department</th>
                                        <th class="dt_th">Employee Type</th>
                                        <th class="dt_th">Location</th>
                                        <th class="dt_th">Approver</th>
                                        <th class="dt_th">Timesheet Start Date</th>
                                        <th class="dt_th">Timesheet End Date</th>
                                        <th class="dt_th">Last Timesheet Date</th>
                                        <th class="dt_th">Timesheet count</th>
                                    </tr>
                                </thead>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="tab-pane fade" id="pills-department" role="tabpanel" aria-labelledby="pills-department-tab" tabindex="0">
            <div class="col-12">
                <div class="row filterArea">
                    <div class="col-4 p-2">
                        <label class="form-label"><b>Department</b></label><br />
                        <select id="lstEmpDepartment" multiple="multiple" class="form-select bg-light">
                            @foreach (var department in departments)
                            {
                                <option value="@department.DepartmentName">@department.DepartmentName</option>
                            }
                        </select>
                    </div>
                    <div class="col-4 p-2">
                        <label class="form-label">&nbsp;</label><br />
                        <button id="btnShowEmployeeList" class="btn btn-primary">Show Employee List</button>
                    </div>
                </div>
                <div id="empNameDepartment" class="d-none mt-5">
                    <div class="row">
                        <div class="col-12">
                            <h3>Name and Department</h3>
                        </div>
                        <div class="clearfix"></div>
                    </div>
                    <div class="row">
                        <div id="empNameDepartmentFailed" class="col-12 alert alert-danger d-none"></div>
                    </div>
                    <div class="row">
                        <div style="overflow:auto;">
                            <table id="tblEmpDepartment" class="table table-striped table-bordered table-responsive">
                                <thead>
                                    <tr>
                                        <th class="dt_th">Technician Name</th>
                                        <th class="dt_th">Department</th>
                                    </tr>
                                </thead>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



 
